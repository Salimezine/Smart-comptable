{
  "name": "Smart-Comptable - Analyse financière",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "analyze-dashboard",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-analyze",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "const secret = $json.body.secret;\nif (secret !== 'sm4rt-c0mpt4bl3-s3cur3-2026') {\n  throw new Error('Accès refusé : secret de validation invalide');\n}\nreturn $input.all();"
      },
      "id": "validate-secret-analyze",
      "name": "Valider secret",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent",
        "authentication": "none",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "={{ $json.body.apiKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"contents\": [ { \"parts\": [ { \"text\": {{ JSON.stringify($json.body.prompt) }} } ] } ] }",
        "options": {}
      },
      "id": "gemini-analyze",
      "name": "Gemini API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [550, 300]
    },
    {
      "parameters": {
        "jsCode": "const text = $input.first().json.candidates[0].content.parts[0].text;\nreturn [{ json: { report: text } }];"
      },
      "id": "extract-report",
      "name": "Extraire le rapport",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "respond-analyze",
      "name": "Répondre",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [850, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Valider secret", "type": "main", "index": 0 }]]
    },
    "Valider secret": {
      "main": [[{ "node": "Gemini API", "type": "main", "index": 0 }]]
    },
    "Gemini API": {
      "main": [[{ "node": "Extraire le rapport", "type": "main", "index": 0 }]]
    },
    "Extraire le rapport": {
      "main": [[{ "node": "Répondre", "type": "main", "index": 0 }]]
    }
  },
